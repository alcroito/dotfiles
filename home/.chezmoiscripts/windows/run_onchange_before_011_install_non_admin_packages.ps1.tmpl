{{- if .install_packages -}}

{{- if eq .chezmoi.os "windows" }}

{{ template "pwsh_refresh_path" . }}

{{ template "pwsh_scoop_install" . }}

# dev tools
echo "Installing non-admin dev tools"

Invoke-ScoopInstall mise
Invoke-ScoopInstall ripgrep
Invoke-ScoopInstall fd
