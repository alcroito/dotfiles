Add-ScoopBucket extras

Invoke-ScoopInstall sysinternals
Invoke-ScoopInstall fzf
Invoke-ScoopInstall zoxide
Invoke-ScoopInstall ag
Invoke-ScoopInstall atuin
Invoke-ScoopInstall psmux
{{ end -}}

echo "Finished installing non-admin dev tools"

# end of windows
{{- end -}}


# end of install_packages
{{- end -}}
