{{- $sf_root := printf "%s/../ai/sf_config" .chezmoi.sourceDir -}}
{{- $manifests := list -}}
{{- if or (eq .location "work") (eq .location "vm") -}}
{{-   $manifests = append $manifests "work" -}}
{{- end -}}
{{- if eq .machine_id "work_macbook_pro_arm" -}}
{{-   $manifests = append $manifests "work_mac" -}}
{{- end -}}
{{ if and .install_packages $manifests -}}

{{ if ne .osid "windows" -}}
#!/usr/bin/env sh
{{ end -}}

export PATH="$HOME/.local/share/mise/shims:$PATH:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin"

# skillfile fetches every entry through the GitHub contents API, which allows
# only 60 anonymous requests per hour, so it wants a token. Its own comes first:
# the chezmoi one is scoped to this account's repos and answers 403 for qt/qtqa,
# which is worse than sending nothing at all, since those repos are public.
# GITHUB_TOKEN is exported here rather than anywhere sourced by a shell, so it
# reaches skillfile and nothing else.
for token_file in skillfile_env.sh github_env.sh; do
  [ -r "$HOME/.config/dotfiles/$token_file" ] || continue
  . "$HOME/.config/dotfiles/$token_file"
done
# The dedicated token overrides a GITHUB_TOKEN the environment carried in: an
# interactive shell exports the chezmoi one through ~/.zshrc, and that is exactly
# the token this is meant to stop using.
if [ -n "${SKILLFILE_GITHUB_TOKEN:-}" ]; then
  export GITHUB_TOKEN="$SKILLFILE_GITHUB_TOKEN"
elif [ -z "${GITHUB_TOKEN:-}" ] && [ -n "${CHEZMOI_GITHUB_ACCESS_TOKEN:-}" ]; then
  export GITHUB_TOKEN="$CHEZMOI_GITHUB_ACCESS_TOKEN"
fi

{{ range $manifests }}
# Hashing the manifest and its lock makes this script re-run when either changes.
# {{ . }}/Skillfile: {{ include (printf "%s/%s/Skillfile" $sf_root .) | sha256sum }}
# {{ . }}/Skillfile.lock: {{ include (printf "%s/%s/Skillfile.lock" $sf_root .) | sha256sum }}
echo "Installing skills from the {{ . }} skillfile manifest"
# Run in the source repo so the lock and the fetch cache stay next to the manifest.
(cd "{{ $sf_root }}/{{ . }}" && skillfile install)
{{ end }}
# end of install_packages
{{ end -}}
