{{- if .install_qt_deps -}}

{{- if eq .chezmoi.os "windows" }}

{{ template "pwsh_refresh_path" . }}

# Without this, if config.toml does not exist yet, `mise use -g` writes the [tools] section into
# the first conf.d/*.toml instead, which is a chezmoi-managed file.
$env:MISE_GLOBAL_CONFIG_FILE = "$HOME\.config\mise\config.toml"

echo "Installing qt dependencies via mise"
mise use -g cmake
echo "Finished installing qt dependencies via mise"

# end of windows
{{- end -}}

# end of install_qt_deps
{{- end -}}
