{{ if .install_packages -}}

{{ if ne .osid "windows" -}}
#!/usr/bin/env bash
{{ end -}}

{{ if eq .osid "darwin" -}}
set -euo pipefail
{{ end -}}

# TODO: Inspire oneself using
# https://github.com/twpayne/dotfiles/blob/master/home/.chezmoiscripts/linux/run_onchange_before_install-packages.sh.tmpl

# Install various packages

{{ if eq .osid "linux-debian" -}}
echo "Installing debian dependencies"
sed -i 's/# en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/g' /etc/locale.gen # needed for debian
echo 'LANG=en_US.UTF-8' > /etc/default/locale
{{ end -}}

{{ if has .osid (list "linux-centos" "linux-rocky" "linux-rhel") -}}
sudo dnf install -y 'dnf-command(config-manager)'
{{ end -}}
{{ if eq .osid "linux-rhel" -}}
{{/* Only the rebuilds call it crb. RHEL names it per release and arch, and a
     subscribed image usually has it enabled already, so a failure here says
     nothing worth stopping for. */}}
sudo dnf config-manager --set-enabled \
  "codeready-builder-for-rhel-$(rpm -E %rhel)-$(rpm -E %_arch)-rpms" || true
{{ end -}}
{{ includeTemplate "pkgs/repos_sh" (dict "ctx" .) }}
{{ includeTemplate "pkgs/install_sh" (dict "ctx" . "phase" "prereq") }}

{{ if or (eq .osid "linux-arch") (eq .osid "linux-endeavouros") -}}
echo "Installing arch dependencies"
sudo localectl set-locale LANG=en_US.UTF-8
sudo pacman -Sy --disable-sandbox --noconfirm which
{{ end -}}

{{ if has .osid (list "linux-ubuntu" "linux-debian") -}}
sudo apt update
sudo locale-gen en_US.UTF-8
export LC_ALL=en_US.UTF-8
export LANG=en_US.UTF-8
{{ end -}}
{{ if eq .osid "darwin" -}}
if ! command -v brew &> /dev/null; then
  echo "Homebrew not found, installing..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
else
  echo "Homebrew already installed"
fi
# Homebrew 6.0 makes "ask mode" (y/n confirmation) the default; disable it for non-interactive installs.
export HOMEBREW_NO_ASK=1
{{ end -}}
{{ if has .osid (list "linux-fedora" "linux-centos" "linux-rocky" "linux-rhel") -}}
{{/* dnf4 wants --setopt=strict=0 and dnf5 --skip-unavailable, and each rejects
     the other's spelling, so ask the binary rather than the release. */}}
if dnf install --help 2>&1 | grep -q -- --skip-unavailable; then
  dnf_skip=--skip-unavailable
else
  dnf_skip=--setopt=strict=0
fi
{{ includeTemplate "pkgs/install_sh" (dict "ctx" . "phase" "system" "extra_args" "$dnf_skip") }}
{{ else -}}
{{ includeTemplate "pkgs/install_sh" (dict "ctx" . "phase" "system") }}
{{ end -}}

{{ if has .osid (list "linux-ubuntu" "linux-debian" "linux-fedora" "linux-centos" "linux-rocky" "linux-rhel") -}}
mkdir -p ~/.local/bin
ln -sf $(which fdfind) ~/.local/bin/fd
{{ end -}}

{{ if ne .osid "windows" -}}
# Install oh my zsh
if [ ! -d "$HOME/.oh-my-zsh" ]; then
  echo "Installing oh-my-zsh"
  ZSH=
  sh -c "$(curl -fsSL https://install.ohmyz.sh/)" "" --unattended
else
  echo "oh-my-zsh already installed"
fi

# Install zsh-autosuggestions
if [ ! -d "$HOME/.oh-my-zsh/custom/plugins/zsh-autosuggestions" ]; then
  echo "Installing zsh-autosuggestions"
  git clone https://github.com/zsh-users/zsh-autosuggestions ${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/plugins/zsh-autosuggestions
else
  echo "zsh-autosuggestions already installed"
fi
touch ~/.zshrc

{{ if eq .chezmoi.os "linux" -}}
sed -i 's/ZSH_THEME=\"robbyrussell\"/ZSH_THEME=\"bira\"/g' ~/.zshrc
{{ else if eq .osid "darwin" -}}
sed -i.bak 's/ZSH_THEME=\"robbyrussell\"/ZSH_THEME=\"bira\"/g' ~/.zshrc
{{ end -}}

{{/* The chsh stays outside the minimal gate: ~/.zshenv only applies to a
     non-interactive ssh command when zsh is the login shell. */ -}}
{{ if eq .chezmoi.os "linux" -}}
# Change the default shell Linux
zsh_path=$(which zsh)
current_user=$(id -un)
current_shell=$(getent passwd "$current_user" | cut -d: -f7)
if [ -n "$zsh_path" ] && [ "$current_shell" != "$zsh_path" ]; then
  echo "Changing default shell to zsh for $current_user"
  sudo chsh -s "$zsh_path" "$current_user"
else
  echo "Default shell is already zsh"
fi
{{ end -}}

# End of not windows
{{ end -}}

# end of install_packages
{{ end -}}
