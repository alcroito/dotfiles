{{/* Skipped for a minimal install, which does not deploy config_managed. */ -}}
{{- if and .install_secrets (not .install_minimal_packages) -}}

{{- if eq .chezmoi.os "windows" }}

$configFile = Join-Path $env:USERPROFILE ".ssh\config"
$includeLine = "Include ~/.ssh/config_managed"
$beginMarker = "# BEGIN chezmoi ssh config_managed include"
$endMarker = "# END chezmoi ssh config_managed include"

# Ensure .ssh directory exists
$sshDir = Join-Path $env:USERPROFILE ".ssh"
if (!(Test-Path $sshDir)) {
    New-Item -ItemType Directory -Force -Path $sshDir | Out-Null
}

# Drop our marked block plus any bare include left by the older version of this
# script, which prepended it to line 1.
$lines = @()
if (Test-Path $configFile) {
    $skip = $false
    foreach ($line in (Get-Content $configFile -ErrorAction SilentlyContinue)) {
        if ($line -eq $beginMarker) { $skip = $true; continue }
        if ($line -eq $endMarker) { $skip = $false; continue }
        if ($skip) { continue }
        if ($line -eq $includeLine) { continue }
        $lines += $line
    }
}

# Appended last so per-host keys are offered before the fallback key. The
# "Host *" is required: an Include inherits the enclosing Host block, so
# without it this would only apply to whichever host block ends the file.
$lines += $beginMarker
$lines += "Host *"
$lines += $includeLine
$lines += $endMarker

Set-Content -Path $configFile -Value $lines

# end of windows
{{- end -}}

# end of install_secrets
{{- end -}}
