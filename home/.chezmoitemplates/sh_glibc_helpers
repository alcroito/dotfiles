glibc_version=$(ldd --version 2>/dev/null | head -n 1 | grep -oE '[0-9]+\.[0-9]+$')

# Succeeds when glibc is older than $1. Never succeeds on non-glibc systems
# (alpine), where the version stays empty and the musl builds are used anyway.
glibc_older_than() {
  [ -n "$glibc_version" ] && \
    [ "$(printf '%s\n%s\n' "$glibc_version" "$1" | sort -V | head -n 1)" != "$1" ]
}

# Unlike the tools above, skillfile publishes no musl asset, so an empty
# glibc_version means it cannot run here rather than "use the musl build".
skillfile_runnable() {
  [ -n "$glibc_version" ] && ! glibc_older_than 2.39
}
