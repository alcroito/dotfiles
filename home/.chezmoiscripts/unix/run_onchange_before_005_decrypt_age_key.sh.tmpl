{{ if .install_github_tokens -}}
#!/usr/bin/env sh

# Wrapper: the logic lives in the repo script, which the [hooks.apply.pre] hook
# in .chezmoi.toml.tmpl also runs. This script stays because the hook cannot
# handle a rotation: the hook's recipient comes from the config, rendered once at
# init, so it is stale until the next `chezmoi init`, while this script's is
# rendered from the pulled source. That interpolation is also what makes
# run_onchange re-run it. It covers `chezmoi update` too, which applies files
# without firing apply hooks.
#
# The guard keeps a missing helper from failing the whole apply.

script="{{ .chezmoi.sourceDir }}/../scripts/unix/decrypt-chezmoi-age-key.sh"
[ -f "$script" ] && sh "$script" "{{ .age_recipient }}"
exit 0
{{ end -}}
