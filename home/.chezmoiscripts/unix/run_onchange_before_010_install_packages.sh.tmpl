{{ if .install_packages -}}

{{ if ne .osid "windows" -}}
#!/usr/bin/env bash
{{ end -}}

{{ if eq .osid "darwin" -}}
set -euo pipefail
{{ end -}}

# TODO: Inspire oneself using
# https://github.com/twpayne/dotfiles/blob/master/home/.chezmoiscripts/linux/run_onchange_before_install-packages.sh.tmpl

# Install various packages

{{ if eq .osid "linux-debian" -}}
echo "Installing debian dependencies"
sed -i 's/# en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/g' /etc/locale.gen # needed for debian
echo 'LANG=en_US.UTF-8' > /etc/default/locale
{{ end -}}

{{ if or (eq .osid "linux-rocky") (eq .osid "linux-rhel") -}}
echo "Installing rocky / rhel dependencies"
sudo dnf install -y 'dnf-command(config-manager)'
{{ if eq .osid "linux-rocky" -}}
sudo dnf config-manager --set-enabled crb
{{ else -}}
{{/* Only the rebuilds call it crb. RHEL names it per release and arch, and a
     subscribed image usually has it enabled already, so a failure here says
     nothing worth stopping for. */}}
sudo dnf config-manager --set-enabled \
  "codeready-builder-for-rhel-$(rpm -E %rhel)-$(rpm -E %_arch)-rpms" || true
{{ end -}}
{{ end -}}

{{ if or (eq .osid "linux-centos") (eq .osid "linux-rocky") (eq .osid "linux-rhel") -}}
echo "Installing centos / rocky / rhel dependencies"
sudo dnf install -y epel-release
{{ if lt (int .chezmoi.osRelease.versionID) 10 -}}
{{/* EPEL Next only ever existed for EL9 and earlier. */}}
sudo dnf install -y epel-next-release
{{ end -}}
# util-linux-user provides chsh
sudo dnf install -y util-linux-user which
{{ end -}}

{{ if or (eq .osid "linux-arch") (eq .osid "linux-endeavouros") -}}
echo "Installing arch dependencies"
sudo localectl set-locale LANG=en_US.UTF-8
sudo pacman -Sy --disable-sandbox --noconfirm which
{{ end -}}

{{ if or (eq .osid "linux-ubuntu") (eq .osid "linux-debian")  -}}
echo "Installing ubuntu-like dependencies"

sudo apt install -y locales
sudo locale-gen en_US.UTF-8
export LC_ALL=en_US.UTF-8
export LANG=en_US.UTF-8

{{ if .install_minimal_packages -}}
sudo apt install -y git zsh ripgrep fd-find jq tig
{{ else -}}
sudo apt install -y ripgrep htop silversearcher-ag fd-find git zsh tig jq atool tmux

# btop not present in debian 11 repos
{{ if not (and (eq .osid "linux-debian") (lt (int (.chezmoi.osRelease.versionID | default "99")) 12)) -}}
sudo apt install -y btop
{{ end -}}
{{ end -}}

mkdir -p ~/.local/bin
ln -s $(which fdfind) ~/.local/bin/fd

{{ else if or (eq .osid "linux-fedora") (eq .osid "linux-centos") (eq .osid "linux-rocky") (eq .osid "linux-rhel") -}}
echo "Installing rhel-like dependencies"
{{ if .install_minimal_packages -}}
sudo dnf install -y git zsh ripgrep fd-find jq tig
{{ else -}}
{{/* dnf4 wants --setopt=strict=0 and dnf5 --skip-unavailable, and each rejects
     the other's spelling, so ask the binary rather than the release. Without it
     a single name missing from a release aborts the transaction: atool is absent
     on EL10 and used to take htop, btop and tmux down with it. */}}
if dnf install --help 2>&1 | grep -q -- --skip-unavailable; then
  dnf_skip=--skip-unavailable
else
  dnf_skip=--setopt=strict=0
fi

sudo dnf install -y $dnf_skip ripgrep htop fd-find git zsh tig btop jq tmux

# atool has no EPEL 10 build, the same way the silver searcher below has none.
{{ if or (eq .osid "linux-fedora") (lt (int .chezmoi.osRelease.versionID) 10) -}}
sudo dnf install -y $dnf_skip atool
{{ end -}}

# Only install the silver searcher up to fedora 42 or centos / rocky / rhel 9.
# Fedora 43+ and centos / rocky / rhel 10+ removed them
{{ if eq .osid "linux-fedora" -}}
{{ if lt (int .chezmoi.osRelease.versionID) 43 -}}
sudo dnf install -y the_silver_searcher
{{ end -}}
{{ else if or (eq .osid "linux-centos") (eq .osid "linux-rocky") (eq .osid "linux-rhel") -}}
{{ if lt (int .chezmoi.osRelease.versionID) 10 -}}
sudo dnf install -y the_silver_searcher
{{ end -}}
{{ end -}}
{{ end -}}

{{ else if eq .osid "linux-opensuse-leap" -}}
echo "Installing suse dependencies"
{{ if .install_minimal_packages -}}
sudo zypper install -y git zsh ripgrep fd jq tig
{{ else -}}
sudo zypper install -y ripgrep htop the_silver_searcher fd git zsh tig btop jq atool tmux
{{ end -}}

{{ else if or (eq .osid "linux-arch") (eq .osid "linux-endeavouros") -}}
echo "Installing arch dependencies"
{{ if .install_minimal_packages -}}
sudo pacman -Sy --disable-sandbox --noconfirm git zsh ripgrep fd jq tig
{{ else -}}
sudo pacman -Sy --disable-sandbox --noconfirm ripgrep htop the_silver_searcher fd git zsh tig btop jq atool tmux
{{- end }}

{{ else if eq .osid "linux-alpine" -}}
echo "Installing alpine dependencies"
{{ if .install_minimal_packages -}}
sudo apk add git zsh ripgrep fd jq tig
{{ else -}}
sudo apk add ripgrep htop the_silver_searcher fd git zsh tig btop jq tmux

# Only available in edge/testing
sudo apk add atool --repository=http://dl-cdn.alpinelinux.org/alpine/edge/testing/
{{ end -}}

{{ else if eq .osid "darwin" -}}
echo "Installing macOS dependencies"
if ! command -v brew &> /dev/null; then
  echo "Homebrew not found, installing..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
else
  echo "Homebrew already installed"
fi
# Homebrew 6.0 makes "ask mode" (y/n confirmation) the default; disable it for non-interactive installs.
export HOMEBREW_NO_ASK=1
{{ if .install_minimal_packages -}}
brew install git zsh ripgrep fd jq tig atuin fzf mise yazi
{{ else -}}
brew install ripgrep htop the_silver_searcher fd cmake git ninja zsh zoxide tig btop mise fzf yazi fzf aria2 atuin bat jq atool tmux lazydocker
{{ end -}}
# brew install xcodesorg/made/xcodes

{{ else -}}
echo "ERROR: unsupported osid '{{ .osid }}' (os-release ID='{{ .chezmoi.osRelease.id }}', ID_LIKE='{{ .chezmoi.osRelease.idLike | default "" }}'); no package manager branch matched, so no packages were installed." >&2
echo "Add a branch for this distro in run_onchange_before_010_install_packages.sh.tmpl, or normalize its id to a known osid in .chezmoi.toml.tmpl." >&2
exit 1
{{ end -}}

{{ if ne .osid "windows" -}}
# Install oh my zsh
if [ ! -d "$HOME/.oh-my-zsh" ]; then
  echo "Installing oh-my-zsh"
  ZSH=
  sh -c "$(curl -fsSL https://install.ohmyz.sh/)" "" --unattended
else
  echo "oh-my-zsh already installed"
fi

# Install zsh-autosuggestions
if [ ! -d "$HOME/.oh-my-zsh/custom/plugins/zsh-autosuggestions" ]; then
  echo "Installing zsh-autosuggestions"
  git clone https://github.com/zsh-users/zsh-autosuggestions ${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/plugins/zsh-autosuggestions
else
  echo "zsh-autosuggestions already installed"
fi
touch ~/.zshrc

{{ if eq .chezmoi.os "linux" -}}
sed -i 's/ZSH_THEME=\"robbyrussell\"/ZSH_THEME=\"bira\"/g' ~/.zshrc
{{ else if eq .osid "darwin" -}}
sed -i.bak 's/ZSH_THEME=\"robbyrussell\"/ZSH_THEME=\"bira\"/g' ~/.zshrc
{{ end -}}

{{/* The chsh stays outside the minimal gate: ~/.zshenv only applies to a
     non-interactive ssh command when zsh is the login shell. */ -}}
{{ if eq .chezmoi.os "linux" -}}
# Change the default shell Linux
zsh_path=$(which zsh)
current_user=$(id -un)
current_shell=$(getent passwd "$current_user" | cut -d: -f7)
if [ -n "$zsh_path" ] && [ "$current_shell" != "$zsh_path" ]; then
  echo "Changing default shell to zsh for $current_user"
  sudo chsh -s "$zsh_path" "$current_user"
else
  echo "Default shell is already zsh"
fi
{{ end -}}

# End of not windows
{{ end -}}

# end of install_packages
{{ end -}}
