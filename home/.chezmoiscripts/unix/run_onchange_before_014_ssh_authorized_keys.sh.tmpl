{{ if ne .osid "windows" -}}
#!/usr/bin/env bash
{{ end -}}

{{ if and .install_secrets (eq .location "vm") -}}
{{- $key_items := list "work_ssh_2025_dec" "work_ssh_2026_main_pc_key" -}}

AUTH_KEYS="$HOME/.ssh/authorized_keys"

KEY_NAMES=(
{{- range $key_items }}
  '{{ . }}'
{{- end }}
)

PUB_KEYS=(
{{- range $key_items }}
  '{{ (secretJSON "item" "view" "--output" "json" (printf "pass://PersonalSecrets/%s" .)).item.content.content.SshKey.public_key | trim }}'
{{- end }}
)

mkdir -p "$HOME/.ssh"
chmod 700 "$HOME/.ssh"

touch "$AUTH_KEYS"
chmod 600 "$AUTH_KEYS"

# A file whose last line has no newline would otherwise get the next key glued onto it.
if [ -s "$AUTH_KEYS" ] && [ -n "$(tail -c 1 "$AUTH_KEYS")" ]; then
  echo >> "$AUTH_KEYS"
fi

for i in "${!PUB_KEYS[@]}"; do
  PUB_KEY="${PUB_KEYS[$i]}"
  KEY_NAME="${KEY_NAMES[$i]}"
  if [ -z "$PUB_KEY" ]; then
    echo "no public key available for $KEY_NAME, skipping"
    continue
  fi
  if grep -qxF "$PUB_KEY" "$AUTH_KEYS"; then
    echo "$KEY_NAME public key already in authorized_keys"
    continue
  fi
  echo "Adding $KEY_NAME public key to authorized_keys"
  echo "$PUB_KEY" >> "$AUTH_KEYS"
done

# end of install_secrets
{{ end -}}
