{{ if and .install_packages (eq .chezmoi.os "linux") -}}
#!/usr/bin/env sh

# Every package script below calls sudo, but a minimal image (debian netinst,
# alpine) may not ship it, and it can only be installed as root.
if command -v sudo > /dev/null 2>&1; then
  exit 0
fi

if [ "$(id -u)" -ne 0 ]; then
  echo "ERROR: sudo is missing and this is not running as root, so it cannot be installed." >&2
  echo "Install it as root, add this user to the sudo/wheel group, then re-run 'chezmoi apply'." >&2
  exit 1
fi

echo "Installing sudo"
{{ if has .osid (list "linux-ubuntu" "linux-debian") -}}
apt-get update
{{ end -}}
{{/* This runs as root by definition: sudo is what is missing. */}}
{{ includeTemplate "pkgs/install_sh" (dict "ctx" . "phase" "bootstrap_root" "no_sudo" true) }}

# end of install_packages
{{ end -}}
