{{ if and .install_packages (not .install_minimal_packages) -}}

{{ if ne .osid "windows" -}}
#!/usr/bin/env sh
{{ end -}}

# chezmoi does not run scripts through a login shell, so mise may not be on PATH
# yet: it lives in ~/.local/bin when installed by mise.run and in the homebrew
# prefix on macOS.
export PATH="$PATH:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin"

# Without this, if config.toml does not exist yet, `mise use -g` writes the [tools] section into
# the first conf.d/*.toml instead, which is a chezmoi-managed file.
export MISE_GLOBAL_CONFIG_FILE="$HOME/.config/mise/config.toml"

{{ if eq .chezmoi.os "linux" -}}
{{ template "sh_glibc_helpers" . }}
# The release assets are dynamically linked builds made on ubuntu 24.04, so the
# binary needs glibc 2.39 and there is no musl asset to fall back to the way
# yazi has one. Installing it on an older distro only defers the failure to
# 021, where it surfaces as an exec error against the dynamic loader.
if ! skillfile_runnable; then
  echo "skipping skillfile: it needs glibc 2.39+ and this system has ${glibc_version:-no glibc}"
  exit 0
fi
{{ end -}}

echo "Installing skillfile using mise"
# Not in the mise registry, so use the github backend against the release assets.
mise use -g "github:eljulians/skillfile"

# end of install_packages
{{ end -}}
