{{- if .install_packages -}}
{{- if .install_secrets -}}

{{- if eq .chezmoi.os "windows" }}

{{ template "pwsh_refresh_path" . }}

if (!(Get-Command pass-cli.exe -ErrorAction SilentlyContinue)) {
    Write-Host "Installing Proton Pass CLI"
    
    # Download and run the official Proton Pass CLI installer
    $installerPath = Join-Path $env:TEMP "install_proton_pass_cli.ps1"
    Invoke-WebRequest -Uri https://proton.me/download/pass-cli/install.ps1 -OutFile $installerPath
    
    # Run the installer script
    & $installerPath
    
    # Clean up
    Remove-Item $installerPath -ErrorAction SilentlyContinue
    
    Write-Host "Proton Pass CLI installed successfully"
} else {
    Write-Host "Proton Pass CLI binary already present"
}

# The installer prints its directory and declines to add it, so chezmoi - which
# execs pass-cli itself for secretJSON lookups - cannot find it. User scope, so
# no elevation despite what the installer's message suggests.
$passDir = Join-Path $env:LOCALAPPDATA "Programs\ProtonPass"
$userPath = [Environment]::GetEnvironmentVariable("Path", "User")
if ([string]::IsNullOrEmpty($userPath)) { $userPath = "" }
$onPath = @($userPath -split ';' | Where-Object { $_.TrimEnd('\') -ieq $passDir.TrimEnd('\') }).Count -gt 0
if (-not $onPath) {
    Write-Host "Adding $passDir to the user PATH"
    [Environment]::SetEnvironmentVariable("Path", ($userPath.TrimEnd(';') + ";" + $passDir).TrimStart(';'), "User")
}
$env:Path = "$passDir;" + $env:Path

# end of windows
{{- end -}}

# end of install_secrets
{{- end -}}

# end of install_packages
{{- end -}}
