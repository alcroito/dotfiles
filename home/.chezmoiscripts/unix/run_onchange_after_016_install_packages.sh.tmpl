{{ if .install_packages -}}

#!/usr/bin/env zsh

# Temporarily add mise shims to PATH so that we can run `ya` command and other mise tools in
# this session.
export PATH="$HOME/.local/share/mise/shims:$PATH"

{{ if ne .osid "windows" -}}
{{/* The emitter call is this block's last statement, so its exit status becomes
the script's status: a failing `ya pkg add` would abort the apply without ignore_errors. */}}
{{ includeTemplate "pkgs/install_sh" (dict "ctx" . "phase" "ya" "ignore_errors" true) }}

{{ if and (.install_nvim) (.install_nvim_bob) -}}
# Without this, if config.toml does not exist yet, `mise use -g` writes the [tools] section into
# the first conf.d/*.toml instead, which is a chezmoi-managed file.
export MISE_GLOBAL_CONFIG_FILE="$HOME/.config/mise/config.toml"
{{ includeTemplate "pkgs/install_sh" (dict "ctx" . "phase" "bob") }}
if command -v bob > /dev/null 2>&1; then
  bob use stable
else
  echo "bob is not installed, skipping bob use stable" >&2
fi
{{ end -}}

{{ end -}}

# end of install_packages
{{ end -}}
