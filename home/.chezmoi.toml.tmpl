{{- $osid := .chezmoi.os -}}
{{- if hasKey .chezmoi.osRelease "id" -}}
{{-   $osid = printf "%s-%s" .chezmoi.os .chezmoi.osRelease.id -}}
{{- end -}}

{{/* Normalize known arch-family derivatives to linux-arch so the per-distro
     branches match. */}}
{{- $arch_family_osids := list
      "linux-archarm"
-}}
{{- if has $osid $arch_family_osids -}}
{{-   $osid = "linux-arch" -}}
{{- end -}}

{{- $is_wsl := false -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   if (.chezmoi.kernel.osrelease | lower | contains "microsoft") -}}
{{-     $is_wsl = true -}}
{{-   end -}}
{{- end -}}

{{- $arch_alt := "" -}}
{{- if eq .chezmoi.arch "amd64" -}}
{{- $arch_alt = "x86_64" -}}
{{- else if eq .chezmoi.arch "386" -}}
{{- $arch_alt = "x86" -}}
{{- else if eq .chezmoi.arch "arm64" -}}
{{- $arch_alt = "arm64" -}}
{{- else if eq .chezmoi.arch "arm" -}}
{{- $arch_alt = "arm" -}}
{{- end -}}

{{- $location := promptStringOnce . "location" "home or work or vm or agent" "work" -}}

{{/* vm and agent have no keyring for pass-cli and are only reachable over ssh,
     so neither prompts and both take the filesystem secret path. */}}
{{- $is_headless := or (eq $location "vm") (eq $location "agent") -}}

{{/* agent installs only what an llm driving the machine over ssh needs. Set
     install_minimal_packages = false in ~/.config/chezmoi/chezmoi.toml and
     re-apply to get the full toolset; a stored value wins over the location
     default, so a later `chezmoi init` keeps it. */}}
{{- $install_minimal_packages := eq $location "agent" -}}
{{- if hasKey . "install_minimal_packages" -}}
{{- $install_minimal_packages = .install_minimal_packages -}}
{{- end -}}

{{/* On vm and agent, force these on without prompting. The nvim flags stay true
     for agent because install_minimal_packages is what suppresses nvim there;
     that way flipping it needs no `chezmoi init` to re-render this config. */}}
{{- $install_packages := true -}}
{{- $install_nvim := true -}}
{{- $install_nvim_deps := true -}}
{{- $install_nvim_plugs := true -}}

{{- if not $is_headless -}}
{{- $install_packages = promptBoolOnce . "install_packages" "Should packages be installed" false -}}
{{- $install_nvim = promptBoolOnce . "install_nvim" "Should nvim be installed" false -}}
{{- $install_nvim_deps = promptBoolOnce . "install_nvim_deps" "Should nvim dependencies be installed" false -}}
{{- $install_nvim_plugs = promptBoolOnce . "install_nvim_plugs" "Should nvim plugins be installed" false -}}
{{- end -}}

{{/* Forced on for headless hosts: the pass-cli filesystem session and the
     authorized_keys script are what make a vm or an agent reachable at all,
     and both were dead while this was hardcoded off for vm. Prompted once
     everywhere else, so a host that already has secrets keeps them across a
     re-init instead of having its ssh key removed. No bob anywhere. */}}
{{- $install_secrets := false -}}
{{- $install_nvim_bob := false -}}

{{- if $is_headless -}}
{{- $install_secrets = true -}}
{{- else -}}
{{- $install_secrets = promptBoolOnce . "install_secrets" "Should secrets be installed" false -}}
{{- end -}}

{{/* Qt build deps only relevant for work; disabled (no prompt) for home and vm. */}}
{{- $install_qt_deps := false -}}
{{- if eq $location "work" -}}
{{- $install_qt_deps = promptBoolOnce . "install_qt_deps" "Should dependencies to build qt be installed" false -}}
{{- end -}}

{{/* GitHub API tokens for mise and chezmoi, unlocked by the age key. */}}
{{- $install_github_tokens := true -}}
{{- if not $is_headless -}}
{{- $install_github_tokens = promptBoolOnce . "install_github_tokens" "Should GitHub API tokens be installed" false -}}
{{- end -}}

{{- $machine_id := "" -}}
{{- if $is_headless -}}
{{/* Keep the random suffix from the config, otherwise every re-init renames the
     host. The osid prefix is rebuilt so it follows a distro change. */}}
{{- $suffix := "" -}}
{{- if hasKey . "machine_id" -}}
{{- $suffix = .machine_id | splitList "-" | last -}}
{{- end -}}
{{- if eq $suffix "" -}}
{{- $suffix = randAlphaNum 6 -}}
{{- end -}}
{{- $machine_id = printf "%s-%s" $osid $suffix -}}
{{- else -}}
{{- $machine_id = promptStringOnce . "machine_id" "Enter a unique machine id" "" -}}
{{- end -}}

{{- $name := "alcroito" -}}
{{- $email := "alcroito.code@pm.me" -}}
{{- if (or (eq $location "work") (eq $location "vm")) -}}
    {{- $name = "Alexandru Croitor" -}}
    {{- $email = "alexandru.croitor@qt.io" -}}
{{- end -}}

{{/* Also in data, so scripts can read it. */}}
{{- $age_recipient := "age1ysm2fsy3jzu5t8sw2wpgaw4jv754gmd0v58kjw0pmzyya5jtsu0qhfpd4w" -}}

{{/* Store absolue path. Renaming needs a `chezmoi init`. */}}
{{- $decrypt_script := printf "%s/../scripts/unix/decrypt-chezmoi-age-key.sh" .chezmoi.sourceDir -}}
{{- if eq .chezmoi.os "windows" -}}
{{- $decrypt_script = printf "%s/../scripts/windows/Decrypt-ChezmoiAgeKey.ps1" (.chezmoi.sourceDir | replace "\\" "/") -}}
{{- end -}}

encryption = "age"

[age]
  identity = "~/.config/chezmoi/key.txt"
  recipient = {{ $age_recipient | quote }}

{{ if $install_github_tokens -}}
{{/* Decrypts the age identity before the apply reads the source state, which is
     when .chezmoiignore gates the encrypted GitHub token files on that identity.
     Fires for `apply` and for the apply phase of `init --apply`, but not for
     `update`, which is why run_onchange_before_005 still exists. The script form
     lets chezmoi pick the interpreter, so the Windows helper runs under pwsh
     when it is installed rather than Windows PowerShell 5.1. */}}
[hooks.apply.pre]
  script = {{ $decrypt_script | quote }}
  args = [{{ $age_recipient | quote }}]
{{ end -}}

{{ if eq .chezmoi.os "windows" }}
[cd]
  command = "pwsh.exe"
{{ end }}

[data]
    osid = {{ $osid | quote }}
    name = {{ $name | quote }}
    email = {{ $email | quote }}
    install_packages = {{ $install_packages }}
    install_minimal_packages = {{ $install_minimal_packages }}
    install_secrets = {{ $install_secrets }}
    install_nvim = {{ $install_nvim }}
    install_nvim_bob = {{ $install_nvim_bob }}
    install_nvim_deps = {{ $install_nvim_deps }}
    install_nvim_plugs = {{ $install_nvim_plugs }}
    install_qt_deps = {{ $install_qt_deps }}
    install_github_tokens = {{ $install_github_tokens }}
    age_recipient = {{ $age_recipient | quote }}
    is_headless = {{ $is_headless }}
    location = {{ $location | quote }}
    machine_id = {{ $machine_id | quote }}
    arch_alt = {{ $arch_alt | quote }}

[secret]
{{- if and (ne .chezmoi.os "windows") $is_headless }}
  # Headless vm or agent: pass-cli has no keyring. This wrapper sets the filesystem key
  # provider and ensures a session before each lookup (see the script for why).
  command = "{{ .chezmoi.sourceDir }}/../scripts/unix/pass-cli-fs-login.sh"
{{- else if eq .chezmoi.os "windows" }}
{{- /* chezmoi execs this itself, so PATH at apply time is what counts, and the
     official installer leaves its target directory off PATH. Prefer whatever is
     on PATH when this config is rendered, otherwise name the installer's default
     location outright. Single-quoted so the backslashes need no escaping. */}}
{{- $pass_cli := lookPath "pass-cli" }}
{{- if not $pass_cli }}{{ $pass_cli = joinPath .chezmoi.homeDir "AppData" "Local" "Programs" "ProtonPass" "pass-cli.exe" }}{{ end }}
  command = {{ $pass_cli | squote }}
{{- else }}
  command = "pass-cli"
{{- end }}

