{{- if .install_secrets -}}
Host codereview.qt-project.org
Port 29418
User alexandru.croitor
AddKeysToAgent yes
{{- if eq .osid "darwin" }}
UseKeychain yes
{{- end }}
Ciphers +aes256-cbc
IdentityFile ~/.ssh/work_ssh_2025_dec

{{- if eq .machine_id "chie" }}

Host github.com
User git
AddKeysToAgent yes
{{- if eq .osid "darwin" }}
UseKeychain yes
{{- end }}
IdentityFile ~/.ssh/work_ssh_2025_dec
{{- end }}

# IdentitiesOnly stops agent keys being offered too, which exhausts the
# server's MaxAuthTries before ssh ever falls back to password auth.
Host *
IdentityFile ~/.ssh/work_ssh_2025_dec
IdentitiesOnly yes
{{- end -}}
