{{- $sf_root := .chezmoi.sourceDir | replace "\\" "/" -}}
{{- $sf_root = printf "%s/../ai/sf_config" $sf_root -}}
{{- $manifests := list -}}
{{- if or (eq .location "work") (eq .location "vm") -}}
{{-   $manifests = append $manifests "work" -}}
{{- end -}}
{{- if eq .machine_id "work_macbook_pro_arm" -}}
{{-   $manifests = append $manifests "work_mac" -}}
{{- end -}}
{{- if and .install_packages $manifests -}}

{{- if eq .chezmoi.os "windows" }}

{{ template "pwsh_refresh_path" . }}

# skillfile is a mise-managed tool, so reach it through the shims rather than
# relying on the profile having activated mise.
$env:Path = "$env:LOCALAPPDATA\mise\shims;$env:Path"

# skillfile fetches every entry through the GitHub contents API, which allows
# only 60 anonymous requests per hour, so it wants a token. Its own comes first:
# the chezmoi one is scoped to this account's repos and answers 403 for qt/qtqa,
# which is worse than sending nothing at all, since those repos are public.
# Both files are POSIX shell, so parse them instead of sourcing them, and set
# GITHUB_TOKEN only in this script's environment so it reaches skillfile alone.
$token_sources = @(
  @{ File = "skillfile_env.sh"; Name = "SKILLFILE_GITHUB_TOKEN" }
  @{ File = "github_env.sh"; Name = "CHEZMOI_GITHUB_ACCESS_TOKEN" }
)
$tokens = @{}
foreach ($source in $token_sources) {
  $path = Join-Path $HOME ".config/dotfiles/$($source.File)"
  if (-not (Test-Path $path)) { continue }
  $token_line = Select-String -Path $path -Pattern "^\s*export\s+$($source.Name)=(.+)$" | Select-Object -First 1
  if ($token_line) {
    $tokens[$source.Name] = $token_line.Matches[0].Groups[1].Value.Trim().Trim('"').Trim("'")
  }
}

# The dedicated token overrides a GITHUB_TOKEN the environment carried in, for
# the reason the unix script explains.
if ($tokens.SKILLFILE_GITHUB_TOKEN) {
  $env:GITHUB_TOKEN = $tokens.SKILLFILE_GITHUB_TOKEN
} elseif (-not $env:GITHUB_TOKEN -and $tokens.CHEZMOI_GITHUB_ACCESS_TOKEN) {
  $env:GITHUB_TOKEN = $tokens.CHEZMOI_GITHUB_ACCESS_TOKEN
}

{{ range $manifests }}
# Hashing the manifest and its lock makes this script re-run when either changes.
# {{ . }}/Skillfile: {{ include (printf "%s/%s/Skillfile" $sf_root .) | sha256sum }}
# {{ . }}/Skillfile.lock: {{ include (printf "%s/%s/Skillfile.lock" $sf_root .) | sha256sum }}
echo "Installing skills from the {{ . }} skillfile manifest"
# Run in the source repo so the lock and the fetch cache stay next to the manifest.
Push-Location "{{ $sf_root }}/{{ . }}"
skillfile install
Pop-Location
{{ end }}
# end of windows
{{- end -}}

# end of install_packages
{{- end -}}
