{{- /* PowerShell twin of pkgs/install_list_sh. scoop installs one app per
invocation, so this emits one line per name. */ -}}
{{- $env := includeTemplate "pkgs/env" .ctx | fromJson -}}
{{- $m := get $.ctx.pkg_managers $env.manager -}}
{{- range $n := (get (get $.ctx.pkg_lists .list) $env.manager | default list) }}
{{ $m.install }} {{ $n }}
{{- end }}
