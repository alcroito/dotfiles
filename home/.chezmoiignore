{{- if ne .chezmoi.os "windows" }}
# Paths to ignore on Linux / macOS
Documents/PowerShell/Microsoft.PowerShell_profile.ps1
Documents
AppData/Local/nvim/init.vim
AppData
.chezmoiscripts/windows/**

{{ if eq .chezmoi.os "linux" }}
# macOS paths to ignore on Linux
private_Library/**
Library/**
{{ end }}

{{- else }}
# Paths to ignore on Windows
.config/nvim/init.vim
# yazi reads %APPDATA%\yazi\config on Windows, so the XDG copy is dead weight.
.config/yazi
.zprofile
.chezmoiscripts/unix/**
Library/**

{{ if or (env "SSH_CONNECTION") (env "SSH_CLIENT") }}
# pass-cli cannot reach Windows Credential Manager from an SSH session, so the
# key templates fall back to a warning stub. Ignoring the targets keeps an apply
# over SSH from overwriting key material that is already in place; run it from an
# RDP or console session to install or rotate the key.
.ssh/work_ssh_2025_dec
.ssh/work_ssh_2025_dec.pub
{{ end }}
{{- end }}

key.txt.age

{{/* Gated on the age identity too: without it chezmoi cannot decrypt these
     files and aborts the whole apply, taking every later target with it. The
     identity is written by run_onchange_before_005_decrypt_age_key, which needs
     an interactive passphrase prompt, so a headless run has no key and skips
     these files until the next apply. */}}
{{ $age_key := joinPath .chezmoi.homeDir ".config" "chezmoi" "key.txt" }}
{{ if or (not .install_github_tokens) (not (stat $age_key)) }}
.config/mise/github_tokens.toml
.config/dotfiles/github_env.sh
{{ end }}

{{/* ~/.zshenv exists only so a non-interactive `ssh host cmd` still finds mise,
     which is what the agent location is for. */}}
{{- if ne .location "agent" }}
.zshenv
{{- end }}

{{/* A minimal install has none of the tools these files configure. The ssh key
     material is here too: it stays off the machine until
     install_minimal_packages is flipped to false. config_managed has to go with
     the private key, because its `Host *` block points IdentitiesOnly at a key
     that would otherwise be missing, which breaks all outgoing ssh. */}}
{{- if .install_minimal_packages }}
.ssh/config_managed
.ssh/work_ssh_2025_dec
.ssh/work_ssh_2025_dec.pub
{{- if ne .chezmoi.os "windows" }}
.config/nvim
.config/atuin
.config/opencode
.vimrc
.tigrc
.ripgreprc
.spaceshiprc.zsh
.cat_custom.omp.yaml
Library/**
{{- else }}
AppData/Local/nvim
AppData/Local/Packages
Documents/PowerShell
Documents/WindowsPowerShell
{{- end }}
{{- end }}
